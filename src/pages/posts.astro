---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

export const prerender = false; // Needs SSR enabled to read URL parameters on the fly

const posts = await getCollection('post');

// Get the requested post ID from the URL (e.g., /posts?id=Hello-dee-doop)
const postId = Astro.url.searchParams.get('id');
const selectedPost = posts.find(p => p.id === postId);

let Content = null;
if (selectedPost) {
  const rendered = await render(selectedPost);
  Content = rendered.Content;
}
---

<Layout title="notepad.exe - cyanide.net!" lastUpdated="26/07/2026" version="v1.5">
    {selectedPost ? (
        <div class="active-post-view">
            <a href="/posts" class="back-btn">&larr; Back to Notepad</a>
            <h2>{selectedPost.data.title}</h2>
            <span class="post-date">({selectedPost.data.date})</span>
            <hr style="margin: 15px 0; border: 1px dashed #000;" />
            <article>
                <Content />
            </article>
        </div>
    ) : (
        <div class="default-view">

            <hr style="margin: 20px 0; border: 1px dashed #000;" />

            <h2>Recent Notepad Entries</h2>
            {posts.length === 0 ? (
                <p><em>No log files found... yet.</em></p>
            ) : (
                <ul>
                  {posts.map(post => (
                    <li>
                      <a href={`/posts?id=${post.id}`} class="post-link">
                        <strong>{post.data.title}</strong>
                      </a> 
                      <span class="post-date">({post.data.date})</span>
                    </li>
                  ))}
                </ul>
            )}
        </div>
    )}
</Layout>